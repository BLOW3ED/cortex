{
  "name": "cortex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "App local-first para estudiar Ingeniería en IA (IPN, plan 2020).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H localhost -p 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H localhost -p 3000",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "telemetry:check": "NEXT_TELEMETRY_DISABLED=1 next telemetry status",
    "start:e2e": "NEXT_TELEMETRY_DISABLED=1 next start -H localhost -p 3100",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:content",
    "content:check": "tsx scripts/content-check.ts",
    "test:content": "vitest run --project content"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "geist": "1.7.2",
    "hast-util-to-html": "9.0.5",
    "katex": "0.16.47",
    "lucide-react": "1.49.0",
    "mathjs": "15.2.0",
    "mathlive": "0.111.0",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "ts-fsrs": "5.4.2",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
